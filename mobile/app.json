{
  "expo": {
    "name": "Smart Home IoT 2026",
    "slug": "smart-home-iot-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "../assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071B46"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.edu.smarthome2026"
    },
    "android": {
      "package": "vn.edu.smarthome2026",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "../assets/adaptive-icon.png",
        "backgroundColor": "#2850E8"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "../assets/favicon.png"
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "31c2dea5-ec99-4e74-8f60-fbdda8a67c20"
      }
    },
    "owner": "khanh2605iot"
  }
}
