# ==========================================================
# SMART HOME IoT 2026 - MOBILE APP (EXPO SDK 54) ENV EXAMPLE
# Copy file này thành .env và điền cấu hình Firebase Web App.
# ==========================================================

# Địa chỉ IPv4 LAN của máy tính chạy Backend Node.js
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.15:3000/api
EXPO_PUBLIC_HOME_ID=home1

# Firebase Web SDK Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourPublicFirebaseWebApiKey
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=smart-home-iot-2026.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://smart-home-iot-2026-default-rtdb.asia-southeast1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=smart-home-iot-2026
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=smart-home-iot-2026.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
