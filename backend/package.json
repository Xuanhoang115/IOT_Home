{
  "name": "smarthome-iot-backend",
  "version": "1.0.0",
  "description": "Smart Home IoT 2026 - Backend REST API, MQTT Bridge (HiveMQ TLS), Firebase Admin Sync & ESP32 Simulator",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "simulator": "tsx simulator/esp32-simulator.ts",
    "seed": "tsx ../scripts/seed-firebase.ts",
    "test:hivemq": "tsx ../scripts/test-hivemq.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.1.0",
    "mqtt": "^5.10.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
