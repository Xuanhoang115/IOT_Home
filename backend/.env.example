# ==========================================================
# SMART HOME IoT 2026 - BACKEND ENVIRONMENT VARIABLES EXAMPLE
# Copy file này thành .env và điền giá trị thực tế.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env LÊN GIT!
# ==========================================================

PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
HOME_ID=home1
COMMAND_TIMEOUT_MS=8000
ALERT_COOLDOWN_MS=60000
SENSOR_LOG_INTERVAL_MS=60000

# HiveMQ Cloud Broker (MQTT over TLS)
HIVEMQ_HOST=u1a4013a.ala.eu-central-1.emqxsl.com
HIVEMQ_PORT=8883
HIVEMQ_PROTOCOL=mqtts
HIVEMQ_USERNAME=smarthome_backend
HIVEMQ_PASSWORD="admin123"

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=smart-home-iot-2026
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@smart-home-iot-2026.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://smart-home-iot-2026-default-rtdb.asia-southeast1.firebasedatabase.app
